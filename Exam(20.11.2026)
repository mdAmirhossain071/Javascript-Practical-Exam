//Q15. Array Statistics .

let _numbers =[4,6,2,4,7,2,3,9,2,8];
let sum = 0;
let largest_ = _numbers[0];
let smallest = _numbers[0];
for (let i = 0; i < _numbers.length; i++) {
    sum += _numbers[i];

    if (_numbers[i] > largest_) { 
        largest_ = _numbers[i];
    }

    if (_numbers[i] < smallest) {
        smallest = _numbers[i];
    }
}

let average = sum / _numbers.length;
console.log("Sum:", sum);
console.log("Average:", average);
console.log("Largest number:", largest_);
console.log("Smallest number:", smallest);

