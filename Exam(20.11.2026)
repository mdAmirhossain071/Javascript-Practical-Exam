//Q13. Basic Calculator Using Switch .

let num3 = parseFloat(prompt("Enter the first number:"));
let _operator = prompt("Enter an operator(+, -, *, /,):");
let num4 = parseFloat(prompt("Enter the second number:"));

let _result;
switch (_operator) {
  case "+":
    _result = num3 + num4;
    console.log(`${num3} + ${num4} = ${_result}`);
    break;

  case "-":
    _result = num3 - num4;
    console.log(`${num3} - ${num4} = ${_result}`);
    break;

  case "*":
    _result = num3 * num4;
    console.log(`${num3} * ${num4} = ${_result}`);
    break;

  case "/":
    if (num3 === 0) {
      console.log("Error: Cannot divide by zero.");
    } else {
      _result = num3 / num4;
      console.log(`${num3} / ${num4} = ${_result}`);
    }
    break;

  default:
    console.log("Invalid operator! Please use +, -, *, or /.");
}

