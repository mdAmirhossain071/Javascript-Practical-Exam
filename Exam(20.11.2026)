// Q22. Prime Number Checker .

let num = 7;
let isPrime = true;

if (num <= 1) {
  isPrime = false;
} else {
  for (let i = 2; i < num; i++) {
    if (num % i === 0) {
      isPrime = false;
      break;    // Stop the loop if a divisor is found.
    }
  }
}

console.log(num + (isPrime ? " is a Prime Number" : " is Not a Prime Number"));

// Q23. Reverse a Number

let q = 12345;
let reversed = 0;

while (q > 0) {
    let lastDigit = q % 10; 
    reversed = (reversed * 10) + lastDigit; 
    q = Math.floor(q / 10); 
}

console.log(reversed); // Output: 54321

